diff --git a/nginx.conf b/nginx.conf
index 2180fc2..564022d 100644
--- a/nginx.conf
+++ b/nginx.conf
@@ -157,6 +157,40 @@ server {
         proxy_set_header X-Forwarded-Proto $scheme;
     }
 
+    # Nuxt build assets are content-hashed and immutable, so Nginx can serve them
+    # from disk instead of paying a Node round-trip on the 1-CPU VPS. `root`
+    # (not `alias`) keeps the historical alias+try_files interaction out of reach.
+    # A missing file falls through to @node, so an unmounted or stale build
+    # directory degrades to the pre-patch behaviour instead of breaking the site.
+    #
+    # Compose mounts nothing at this root, so every request takes @node until a
+    # bind mount of web-nuxt/.output/public is added. The systemd render rewrites
+    # the root to the live output directory (scripts/ops/render_nginx_config.py).
+    #
+    # `add_header` inside a location REPLACES the server-level set, so the headers
+    # Nitro sends for /_nuxt/** (web-nuxt/nuxt.config.ts:216-227) are restated here
+    # instead of inherited. `gzip_static` picks up the .gz emitted by
+    # nitro.compressPublicAssets.
+    location ^~ /_nuxt/ {
+        root /var/www/nuxt;
+        gzip_static on;
+        access_log off;
+        add_header Cache-Control "public, max-age=31536000, immutable" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        add_header X-Served-By "nginx-static" always;
+        try_files $uri @node;
+    }
+
+    location @node {
+        proxy_pass http://vl360_nuxt;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 120s;
+    }
+
     location / {
         proxy_pass http://vl360_nuxt;
         proxy_http_version 1.1;
