+
+
+# ── Immutable Nuxt assets served by Nginx (perf debt closed 2026-08-08) ──────
+#
+# The 2026-07-02 perf pass added a `/_nuxt/` static block BY HAND to
+# /etc/nginx/sites-enabled/vinhlong360 on the VPS.  That file is rendered from
+# nginx-ssl.conf (docs/deployment-guide.md, "SSL Setup"), so re-running the SSL
+# step would have silently reverted the offload.  These tests pin the block into
+# the reviewed source and pin the systemd rewrite that makes it point at the
+# live build output.
+
+
+def _nuxt_serving_servers(filename: str) -> list[Statement]:
+    """Public servers that actually serve Nuxt (skips the :80 redirect server)."""
+    servers = [
+        server
+        for server in _public_servers(ROOT / filename)
+        if any(
+            location.modifier == ""
+            and location.pattern == "/"
+            and _directive(location.body, "proxy_pass")
+            for location in _locations(server)
+        )
+    ]
+    assert servers
+    return servers
+
+
+@pytest.mark.parametrize("filename", ["nginx.conf", "nginx-ssl.conf"])
+def test_nuxt_assets_are_served_from_disk_with_node_fallback(filename: str):
+    for server in _nuxt_serving_servers(filename):
+        static = _location_for(server, "^~", "/_nuxt/")
+
+        # `root`, not `alias`: alias+try_files is the historically buggy pairing.
+        assert [tuple(item.parts) for item in _directive(static.body, "root")] == [
+            ("root", "/var/www/nuxt")
+        ]
+        assert not _directive(static.body, "alias")
+
+        # The fallback is what makes a missing/stale build directory harmless.
+        assert [tuple(item.parts) for item in _directive(static.body, "try_files")] == [
+            ("try_files", "$uri", "@node")
+        ]
+        assert [tuple(item.parts) for item in _directive(static.body, "gzip_static")] == [
+            ("gzip_static", "on")
+        ]
+
+        # add_header inside a location REPLACES the server-level set, so the
+        # headers Nitro would have sent must be restated here.
+        headers = {item.parts[1]: item.parts[2] for item in _directive(static.body, "add_header")}
+        assert headers["Cache-Control"] == "public, max-age=31536000, immutable"
+        assert headers["X-Content-Type-Options"] == "nosniff"
+
+        # No proxy_pass here — otherwise the block would enter the backend
+        # ingress inventory and demand a launch-indexing-policy exception.
+        assert not _directive(static.body, "proxy_pass")
+
+        fallback = _location_for(server, "", "@node")
+        assert len(_directive(fallback.body, "proxy_pass")) == 1
+
+
+@pytest.mark.parametrize("filename", ["nginx.conf", "nginx-ssl.conf"])
+def test_nuxt_assets_win_over_the_catch_all_location(filename: str):
+    for server in _nuxt_serving_servers(filename):
+        locations = _locations(server)
+        resolved = _resolve_location(locations, "/_nuxt/entry.abc123.js")
+
+        assert resolved is not None
+        assert (resolved.modifier, resolved.pattern) == ("^~", "/_nuxt/")
+
+
+def test_nuxt_static_block_exists_in_both_http_and_https_configs():
+    """Drift guard: the HTTPS config is what prod renders from."""
+    for filename in ("nginx.conf", "nginx-ssl.conf"):
+        source = (ROOT / filename).read_text(encoding="utf-8")
+        assert source.count("location ^~ /_nuxt/ {") == 1
+        assert source.count("location @node {") == 1
+
+
+def test_https_nuxt_block_restates_hsts_it_would_otherwise_lose():
+    for server in _nuxt_serving_servers("nginx-ssl.conf"):
+        static = _location_for(server, "^~", "/_nuxt/")
+        headers = {item.parts[1]: item.parts[2] for item in _directive(static.body, "add_header")}
+
+        assert headers["Strict-Transport-Security"] == (
+            "max-age=63072000; includeSubDomains; preload"
+        )
+
+
+@pytest.mark.parametrize("filename", ["nginx.conf", "nginx-ssl.conf"])
+def test_systemd_render_points_static_root_at_the_live_build_output(filename: str):
+    from scripts.ops.render_nginx_config import render_config
+
+    source = (ROOT / filename).read_text(encoding="utf-8")
+    rendered = render_config(source, topology="systemd")
+
+    assert "root /opt/vinhlong360/web-nuxt/.output/public;" in rendered
+    assert "root /var/www/nuxt;" not in rendered
+    # The fallback must survive the rewrite, else a missing asset 404s.
+    assert "try_files $uri @node;" in rendered
+    assert "proxy_pass http://127.0.0.1:3000;" in rendered
+
+
+@pytest.mark.parametrize("filename", ["nginx.conf", "nginx-ssl.conf"])
+def test_compose_render_keeps_the_bind_mount_static_root(filename: str):
+    from scripts.ops.render_nginx_config import render_config
+
+    source = (ROOT / filename).read_text(encoding="utf-8")
+
+    assert render_config(source, topology="compose") == source
+    assert "root /var/www/nuxt;" in source
+
+
+def test_systemd_render_refuses_to_ship_a_compose_only_static_root():
+    """A Compose path the textual rewrite misses must fail the render, not ship.
+
+    Re-spacing the directive is exactly what a future editor would do; the
+    rewrite is a literal string replace and would silently skip it.
+    """
+    from scripts.ops.render_nginx_config import render_config
+
+    source = (ROOT / "nginx-ssl.conf").read_text(encoding="utf-8").replace(
+        "root /var/www/nuxt;",
+        "root  /var/www/nuxt;",
+        1,
+    )
+
+    with pytest.raises(ValueError, match="Compose-only static root"):
+        render_config(source, topology="systemd")
