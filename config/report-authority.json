{
  "schema_version": "1",
  "canonical_table": "reports",
  "id_column": "id",
  "api_id_field": "report_id",
  "idempotency_key": ["actor_scope", "idempotency_key"],
  "revision_column": "revision",
  "target_types": ["entity", "facility", "post", "comment", "user", "stale_field"],
  "legacy_jsonl": {
    "path": "agent/data/reports.jsonl",
    "mode": "read_import_only",
    "cutover_marker": "corrections-cutover.marker"
  },
  "privacy": {
    "contact": "ciphertext_or_digest_only",
    "exclude": ["ip", "bearer_token", "secret"]
  }
}
