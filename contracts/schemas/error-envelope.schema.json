{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinhlong360.vn/contracts/schemas/error-envelope.schema.json",
  "title": "API Error Envelope",
  "description": "Stable error metadata shared by frontend API consumers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Problem type identifier, commonly an absolute URI or about:blank."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP status code associated with the problem."
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "Stable machine-readable application error code."
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional request correlation identifier."
    }
  }
}
